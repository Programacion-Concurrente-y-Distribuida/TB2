FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY ML_and_concurrent_model/go.mod ML_and_concurrent_model/go.sum ./
RUN go mod download
COPY ML_and_concurrent_model/ .
RUN CGO_ENABLED=0 GOOS=linux go build -o /api ./cmd/api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /api /api
EXPOSE 8080
ENTRYPOINT ["/api"]
