FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY ML_and_concurrent_model/go.mod ML_and_concurrent_model/go.sum ./
RUN go mod download
COPY ML_and_concurrent_model/ .
RUN CGO_ENABLED=0 GOOS=linux go build -o /ml-node ./cmd/ml-node

FROM alpine:3.20
COPY --from=builder /ml-node /ml-node
EXPOSE 9000
ENTRYPOINT ["/ml-node"]
